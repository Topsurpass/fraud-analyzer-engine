# Production configuration for the EC2 host. Copy to `.env.prod` and fill in.
#
#     cp .env.prod.example .env.prod && $EDITOR .env.prod
#     ./preflight.sh          # checks every value below before anything starts
#
# `.env.prod` is gitignored and holds two live secrets. It should be mode 0600
# and owned by the user that runs the stack; preflight.sh checks both.
#
# Nothing here is read by the application directly. Compose interpolates these
# into the container environments in docker-compose.prod.yml, which is where to
# look for what each one actually does.


# --- The address people type ------------------------------------------------
#
# The EC2 public DNS name (ec2-1-2-3-4.compute-1.amazonaws.com) or the public
# IP. Caddy issues a self-signed certificate for exactly this string, so a
# browser that reaches the box by a different name will warn about a mismatch
# on top of warning about the self-signed certificate.
#
# Prefer the public DNS name over the IP: a stopped and restarted instance gets
# a new public IP unless it has an Elastic IP, and the certificate would then
# be for an address nobody uses.
SWITCHBOARD_PUBLIC_HOST=ec2-0-0-0-0.compute-1.amazonaws.com


# --- App-state database (RDS) -----------------------------------------------
#
# This is the analyzer's own storage: user accounts, connection profiles, saved
# queries, dashboards, audit log. NOT the fraud data being analysed - those are
# target connections, configured in the app.
#
# Take the endpoint from the RDS console. The instance should NOT be publicly
# accessible; it should sit in the same VPC as this instance, with a security
# group that allows 5432 only from the EC2 instance's security group.
#
# ## The two TLS parameters, and why they are not optional
#
#   sslmode=verify-full   Encrypts AND checks that the server presenting the
#                         certificate is the host you asked for. `require`,
#                         which is what most copy-pasted URLs carry, encrypts
#                         but verifies nothing: anything that can answer on
#                         that address inside the VPC can read every credential
#                         this database stores. There is no reason to accept
#                         that when the alternative is one word.
#
#   sslrootcert=          The CA bundle to check against, as a path INSIDE the
#                         container. /app/certs/trust-bundle.pem is built by
#                         the analyzer's Dockerfile from the system roots plus
#                         AWS's 108 regional RDS roots, so it covers both a
#                         modern RDS certificate and an older self-signed one.
#                         A path on the host does not exist in here.
#
# ## What NOT to carry over from a Neon URL
#
#   channel_binding=require   A Neon idiom. It fails outright on an RDS
#                             instance whose password encryption is still md5
#                             rather than scram-sha-256, with an error about
#                             channel binding that says nothing about md5.
#                             verify-full already gives the property people
#                             reach for this hoping to get. verify.sh reports
#                             which authentication your instance is using.
#
# The password goes in this file and nowhere else. Never in a compose file,
# never in a commit, never in a shell command that lands in ~/.bash_history.
DATABASE_URL=postgresql://USER:PASSWORD@your-db.abcdefg.us-east-1.rds.amazonaws.com:5432/fraud_analyzer?sslmode=verify-full&sslrootcert=/app/certs/trust-bundle.pem


# --- Credential encryption --------------------------------------------------
#
# 32 random bytes, urlsafe-base64. Every target-database password saved through
# the app is encrypted with this and with nothing else.
#
# This is the one value in this file that cannot be recovered or rotated
# casually. Change it and every saved connection keeps every visible field
# correct while every query on it fails to decrypt its password - a failure
# that surfaces one request at a time and looks nothing like its cause. Back it
# up somewhere that is not this instance.
#
# Generate one with:
#     openssl rand -base64 32 | tr '+/' '-_'
FAE_FERNET_KEY=


# --- Sizing -----------------------------------------------------------------
#
# Worker processes for the analyzer. One worker is one core. A poll is
# GIL-bound Python, so a busy board saturates a single worker: measured at
# 25,000 rows a query, one analyst polling saw 29 ms and ten concurrent
# analysts saw 200 ms - one core running out, not anything queueing badly.
#
# More workers buy real parallelism and cost cache locality: the result cache
# and the rendered-response cache are per process, so N workers can fetch and
# render the same result N times and hold N copies. Start at the instance's
# core count (`nproc`), which preflight.sh prints, and watch the cache hit
# ratio rather than the CPU graph.
WEB_CONCURRENCY=2

# INFO or DEBUG. DEBUG logs every SQL statement, which on a monitoring board
# is a great deal of disk.
FAE_LOG_LEVEL=INFO

# The scheduler is the only part of the service that queries a customer
# database unprompted. Leave it on unless you have a reason.
FAE_SCHEDULER_ENABLED=true

# Alembic runs at startup. Correct for a single instance, which is what this
# compose file describes. Set false and run migrations as a release step if you
# ever run more than one, so two instances do not race the same migration.
FAE_AUTO_MIGRATE=true


# --- Repository layout ------------------------------------------------------
#
# Where the dashboard repository is checked out, relative to this directory or
# absolute. The default assumes the two repositories are siblings:
#
#     /opt/switchboard/fraud-analyzer-engine/deploy/   <- you are here
#     /opt/switchboard/fraud-analyzer-dashboard/
DASHBOARD_CONTEXT=../../fraud-analyzer-dashboard
