# Reverse proxy for the analyzer: TLS, authentication, and a blocked API console.
#
# The analyzer has no authentication of its own and serves an interactive SQL
# console at /docs on the same port as the API. This file is what stands
# between that and the network, so read DOCKER.md ("Before you expose this")
# before changing anything here.
#
# Used by docker-compose.proxy.yml. Two variables, both from the environment:
#   FAE_PUBLIC_HOST       the hostname Caddy serves. Defaults to localhost.
#   FAE_BASIC_AUTH_HASH   bcrypt hash of the API password. No default: an
#                         unset value makes Caddy fail to start rather than
#                         silently serving without a usable credential.
#
# Generate the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'

{
	# No admin API. It is unauthenticated and can rewrite this whole config at
	# runtime, so it has no business being reachable inside a deployment.
	admin off
}

{$FAE_PUBLIC_HOST:localhost} {
	# `tls internal` issues a certificate from Caddy's own local CA, which is
	# what makes this testable offline. For a real deployment delete this line
	# and set FAE_PUBLIC_HOST to a public hostname: Caddy then provisions a
	# Let's Encrypt certificate automatically.
	tls internal

	# `handle` blocks are mutually exclusive and evaluated in written order,
	# unlike bare directives, which Caddy reorders by its own directive table.
	# That ordering is the whole point here: the console has to be refused
	# BEFORE the authentication handler runs, or /docs answers 401 and
	# advertises that something is there.
	@console path /docs /docs/* /redoc /redoc/* /openapi.json
	handle @console {
		respond 404
	}

	handle {
		basic_auth {
			{$FAE_BASIC_AUTH_USER:analyst} {$FAE_BASIC_AUTH_HASH}
		}

		reverse_proxy analyzer:8000 {
			# app/ratelimit.py:116 keys the rate-limit bucket on the FIRST
			# entry of X-Forwarded-For, and the analyzer trusts that header
			# blindly. Exposed directly, rotating it defeats the limiter
			# outright: measured 6/6 requests accepted at a limit of 3.
			#
			# Caddy 2.7+ already replaces an untrusted client-supplied
			# X-Forwarded-For with the real peer address, so the default is
			# safe here (measured on 2.11.4: client sends 1.2.3.4, the backend
			# sees the real address). This line states it anyway, because that
			# guarantee is version-dependent and is relaxed by a broad
			# `trusted_proxies` setting. {remote_host} is the address Caddy
			# accepted the connection from, which a caller cannot forge.
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}

			# The analyzer's slowest legitimate response is bounded by
			# FAE_QUERY_TIMEOUT_S plus FAE_SOCKET_TIMEOUT_GRACE_S (10 + 5 by
			# default). Give the proxy more than that so a slow query returns
			# its own 504 rather than the proxy inventing one.
			transport http {
				response_header_timeout 30s
			}
		}
	}
}
