# Copy to .env for local development. Every value has a working default.

# --- App-state database (this service's own storage) ------------------------
# Which backend stores connections, saved queries, and execution logs.
#   sqlite  a local file, zero setup, fine for development
#   neon    managed Postgres, read from DATABASE_URL below
FAE_DB_BACKEND=sqlite

# Used when FAE_DB_BACKEND=neon. Paste your own connection string; a
# postgresql:// scheme is rewritten to postgresql+psycopg:// automatically.
# NEVER put a real credential in this file - it is committed. Put it in .env.
DATABASE_URL=

# Where the sqlite backend keeps its file.
FAE_SQLITE_APP_DB_PATH=./fraud_analyzer.db

# Full escape hatch. If set, this exact URL is used and FAE_DB_BACKEND is
# ignored. Mainly for tests and for a backend neither option above covers.
# FAE_APP_DB_URL=

# Run "alembic upgrade head" at startup. On by default so a container deploy
# does not need a separate release step. Turn off if you migrate separately or
# run several instances that would race on boot.
FAE_AUTO_MIGRATE=true


# --- Credential encryption --------------------------------------------------
# REQUIRED IN PRODUCTION. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a development key is generated into .secrets/fernet.key (gitignored).
# Losing that key makes every stored credential undecryptable.
FAE_FERNET_KEY=

# --- Row caps ---------------------------------------------------------------
FAE_DEFAULT_ROW_LIMIT=1000
FAE_MAX_ROW_LIMIT=10000
FAE_PREVIEW_ROW_LIMIT=100

# Bounds how much CPU one statement can spend in the parser. sqlparse is pure
# Python and superlinear in token density; unbounded, a 1.6MB statement
# measured 51 seconds before reaching any database.
FAE_MAX_SQL_LENGTH=8000

# Distinct validated statements to memoise. A saved query sends identical SQL
# on every run and every cache-missing poll.
FAE_SQL_VALIDATION_CACHE_SIZE=512

# Refuses a runaway payload while rows are read. row_limit bounds how MANY rows
# come back, not how wide they are: SELECT repeat('x', 1000000000) is one row
# and a gigabyte.
FAE_MAX_RESULT_BYTES=33554432


# --- SQLite target connections ----------------------------------------------
# Directories a sqlite TARGET may point into, comma-separated.
#
# This is a security control, not a convenience. The path is opened by the API
# process, so without a restriction a connection profile is an arbitrary-file-
# read primitive - including this service's own app-state database, which would
# expose every stored credential through the ordinary query endpoints. The
# app-state file is refused regardless of what this allows.
#
# Set to empty to refuse sqlite targets entirely. That is correct for a
# container: the path resolves against the container filesystem, so a path from
# a laptop points at nothing.
FAE_SQLITE_ALLOWED_DIRS=.

# --- Execution --------------------------------------------------------------
FAE_QUERY_TIMEOUT_S=10
FAE_CONNECT_TIMEOUT_S=10

# Serverless Postgres suspends when idle and the first connect after that can
# exceed ten seconds, so the app-state DB gets its own, longer budget.
FAE_APP_DB_CONNECT_TIMEOUT_S=30

# --- Polling ----------------------------------------------------------------
FAE_POLL_INTERVAL_MS=5000

# Approximate memory budget for the poll result cache. It used to be bounded by
# entry count alone, which said nothing about cost: one 10k-row by 5-column
# result measured 1.1MB, so 256 entries was roughly a gigabyte for wide results
# and a small container was OOM-killed long before eviction triggered.
FAE_CACHE_MAX_BYTES=67108864

# --- HTTP -------------------------------------------------------------------
# Comma-separated. Use explicit origins in production, not "*".
FAE_CORS_ORIGINS=*

# Per-client-IP budgets, 0 to disable. There is no auth, so these are the only
# thing bounding an anonymous caller running SQL against a production database.
# The execution bucket must absorb a real dashboard: twelve cards at the
# default interval is 144 polls a minute from one browser.
FAE_RATE_LIMIT_PER_MINUTE=600
FAE_RATE_LIMIT_EXECUTION_PER_MINUTE=300

# Largest accepted request body, checked against Content-Length before the body
# is read.
FAE_MAX_REQUEST_BYTES=1048576


# --- Logging ----------------------------------------------------------------
# Nothing else configures the root logger, so without this uvicorn leaves root
# at WARNING and every INFO line the service emits is discarded - including the
# startup banner that tells you which backend a deployment resolved.
FAE_LOG_LEVEL=INFO
# One JSON object per line, for a log shipper that parses rather than greps.
FAE_LOG_JSON=false


# --- Execution log retention ------------------------------------------------
# One card polling at the default interval writes roughly 17k rows a day on
# cache misses, forever. Pruned at startup. 0 disables.
FAE_LOG_RETENTION_DAYS=30
FAE_MAX_LOGS_PER_QUERY=1000

# --- Target connection pooling ----------------------------------------------
FAE_TARGET_POOL_SIZE=10
FAE_TARGET_MAX_OVERFLOW=5
FAE_MAX_TARGET_ENGINES=32

# How long a request waits for a pooled connection before giving up.
# SQLAlchemy's default is 30s, which outlives the frontend's poll deadline and
# turns pool exhaustion into a hang rather than an error.
FAE_TARGET_POOL_TIMEOUT_S=5

# Client socket deadline is FAE_QUERY_TIMEOUT_S + this grace margin. It must
# stay above the server-side statement timeout, or a slow query is reported as
# a lost connection (502) instead of a timeout (504).
FAE_SOCKET_TIMEOUT_GRACE_S=5

# --- Flag rules --------------------------------------------------------------
# Most queries one "refresh flagged" click may re-run against a target database.
# The flagged view itself reads cache and runs nothing; refresh is the only path
# that executes. Without a bound, one click on a connection with fifty saved
# queries is fifty statements at once against a pool of 10 + 5.
FAE_FLAGGED_REFRESH_MAX_QUERIES=20
