# Created by `mkdir -p ./data` in that recipe; holds a sqlite app-state file.
services/analyzer/data/

# Local rehearsal state (deploy/rehearse.sh): generated certificates, a
# throwaway env file, and the log of what was deployed when.
deploy/.rehearsal/
deploy/deployed.log
